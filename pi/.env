TELEGRAM_BOT_TOKEN=your bot token
TELEGRAM_CHAT_ID=your chat id

# Name shown in every Telegram message
GK_LOCK_NAME=Front door

# --- Second factor: after a valid gesture you must also tap Approve in Telegram ---
# Needs a PRIVATE chat id (positive number) and the Telegram listener running.
GK_REQUIRE_APPROVAL=1
GK_APPROVAL_TIMEOUT=20        # seconds to wait for your tap
GK_APPROVAL_FAIL_OPEN=0       # 1 = allow gesture-only unlocks if Telegram is unreachable (weaker!)

# --- Extras ---
GK_DAILY_SUMMARY_AT=00:00     # send a daily summary at this time (24 h clock)
GK_TELEGRAM_COMMANDS=1        # 0 = alerts only, no commands (use this on a second laptop)

# --- Door rules and testing ---
# Only allow unlocks between these hours (24 h clock). 22-6 wraps past midnight. Empty = any time:
GK_ALLOWED_HOURS=7-23
TESTING ONLY: 1 = failed attempts never lock you out. Keep it OFF for the real demo:
GK_TEST_NO_LOCKOUT=0
